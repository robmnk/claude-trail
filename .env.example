# claude-trail column widths. Copy to ~/.claude/.env (or point $CLAUDE_TRAIL_ENV
# at this file) and uncomment the keys you want to tune. Each value is a positive
# integer of terminal columns; a missing, non-integer, or <= 0 value falls back
# to the built-in default shown below. A real environment variable of the same
# name overrides the value here. Only widths are configurable, not colors. The
# Command column has no key: it takes the remaining width (ratio=1).

# Time column: HH:MM:SS timestamp.
CLAUDE_TRAIL_COL_TIME_WIDTH=8
# Session column: session name or id prefix.
CLAUDE_TRAIL_COL_SESSION_WIDTH=13
# Agent column: subagent tree gutter and label.
CLAUDE_TRAIL_COL_AGENT_WIDTH=24
# Directory column: left-truncated tail of the cwd.
CLAUDE_TRAIL_COL_DIRECTORY_WIDTH=14
# Files column: basenames of files referenced in the command.
CLAUDE_TRAIL_COL_FILES_WIDTH=20
